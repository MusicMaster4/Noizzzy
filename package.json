{
  "name": "noizzzy",
  "version": "1.0.3",
  "description": "Noizzzy — local voice isolation, restoration, and mastering",
  "private": true,
  "main": "electron/main.cjs",
  "author": "MusicMaster4",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run tools:prepare && npm run media:prepare && npm run icons:prepare && npm run web:build && electron .",
    "start": "npm run dev",
    "web:build": "npm run build --prefix web",
    "worker:build": "node scripts/build-worker.mjs",
    "tools:prepare": "node scripts/fetch-uv.mjs",
    "media:prepare": "node scripts/prepare-media-tools.mjs",
    "icons:prepare": "node scripts/prepare-icons.mjs",
    "prepack": "npm run web:build && npm run worker:build && npm run tools:prepare && npm run media:prepare && npm run icons:prepare",
    "pack": "npm run prepack && electron-builder --dir",
    "dist:windows": "npm run prepack && electron-builder --win nsis --x64",
    "dist:mac-arm": "npm run prepack && electron-builder --mac dmg zip --arm64",
    "dist:mac-intel": "npm run prepack && electron-builder --mac dmg zip --x64",
    "test": "node --test electron/tests/*.test.cjs",
    "test:e2e": "npm run web:build && playwright test",
    "test:e2e:packaged": "node scripts/test-packaged.mjs",
    "test:worker-smoke": "node scripts/smoke-worker.mjs",
    "test:worker-restart": "node scripts/test-worker-restart.mjs",
    "test:ai-pipeline": "node scripts/test-ai-pipeline.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "runtime:validate": "node scripts/validate-runtime-requirements.mjs"
  },
  "dependencies": {
    "electron-log": "5.4.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=24"
  }
}
