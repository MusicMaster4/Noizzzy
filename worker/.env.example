# Runtime
VOICE_DATA_DIR=.voice-data
VOICE_MODEL_DIR=models
VOICE_MAX_UPLOAD_MB=5120
VOICE_CORS_ORIGINS=http://localhost:3000
VOICE_FFMPEG=ffmpeg
VOICE_FFPROBE=ffprobe

# Separation: audio-separator downloads this model on first use.
VOICE_SEPARATOR_MODEL=vocals_mel_band_roformer.ckpt
VOICE_SEPARATOR_DEVICE=auto

# Enhancement: install ClearerVoice-Studio and its model dependencies first.
VOICE_ENHANCER_MODEL=MossFormer2_SE_48K
# Recommended because audio-separator and clearvoice currently pin conflicting
# rotary-embedding-torch versions. Use an absolute path on Windows, for example:
# VOICE_ENHANCER_PYTHON=H:/Python/Slop/voice-clean/worker/.clearvoice-venv/Scripts/python.exe

# Never enable in production. When true, missing/failing ML stages use clearly
# labelled FFmpeg development substitutes so the UI can be exercised offline.
VOICE_ALLOW_DEVELOPMENT_FALLBACK=false

# Output retention. Zero keeps completed jobs until process exit/manual deletion.
VOICE_JOB_TTL_HOURS=24
